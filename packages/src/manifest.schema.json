{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://kora.dev/schemas/manifest/1.0.json",
    "title": "KOra Manifest",
    "description": "The KOra project manifest. Declares identity, routing, data sources, and output configuration for the KOra CLI",
    "type": "number",
    "required": ["kora", "identity", "static_roots", "output", "versioning"],
    "additionalProperties": false,

    "properties": {
        "kora": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$",
            "description": "KOra spec version. Must be in MAJOR.MINOR format.",
            "examples": ["1.0"]
        },

        "identity": {
            "type": "object",
            "required": ["name", "description", "base_url", "public_url", "author", "language", "license"],
            "additionalProperties": false,
            "properties": {

                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                },

                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 280,
                    "description": "One or two sentences. Agent's first filter before querying any content."
                },

                "base_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "CLI use only. Used to resolve relative paths during crawl and build. Never surfaced in output."
                },

                "public_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Agent-facing canonical URL. Included in every output payload."
                },

                "author": {
                    "type": "object",
                    "required": ["name", "contact"],
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "contact": {
                            "type": "string",
                            "format": "email"
                        }
                    }
                },

                "language": {
                    "type": "string",
                    "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
                    "description": "BCP 47 language tag. e.g. en, en-US, fr, sw-KE",
                    "examples": ["en", "en-US", "fr", "sw-KE"]
                },

                "license": {
                    "type": "object",
                    "required": ["type"],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": ["public", "restricted", "cc-by", "all-rights-reserved"],
                            "description": "Usage rights for agents consuming this content."
                        },
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Optional. Link to the full license text."
                        }
                    }
                }
            }
        },

        "static_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Allowlist of static paths to crawl. Must be explicit — nothing is included by default.",
            "items": {
                "type": "string",
                "pattern": "^/",
                "description": "Must start with /. Use /** to match all descendants."
            }
        },

        "exclude": {
            "type": "array",
            "uniqueItems": true,
            "description": "Optional. Refines static_roots by excluding matching paths. Must fall within a declared static root.",
            "items": {
                "type": "string",
                "pattern": "^/",
                "description": "Must start with /. Use /** to match all descendants."
            }
        },

        "dynamic_sources": {
            "type": "array",
            "uniqueItems": true,
            "description": "Optional. Declares dynamic API endpoints to fetch and package.",
            "items": {
                "type": "object",
                "required": ["field", "endpoint", "auth", "tier"],
                "additionalProperties": false,
                "properties": {

                "field": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "description": "snake_case identifier. Becomes a key in the output package."
                },

                "endpoint": {
                    "type": "string",
                    "pattern": "^/",
                    "description": "Relative path to the API endpoint. Resolved against base_url at build time."
                },

                "auth": {
                    "type": "object",
                    "required": ["type"],
                    "additionalProperties": false,
                    "properties": {
                    "type": {
                        "type": "string",
                        "enum": ["public", "api_key", "bearer"]
                    },
                    "env": {
                        "type": "string",
                        "description": "Required when type is not public. Name of the environment variable holding the secret.",
                        "pattern": "^[A-Z][A-Z0-9_]*$"
                    }
                    },
                    "if": {
                        "properties": { "type": { "enum": ["api_key", "bearer"] } }
                    },
                    "then": {
                        "required": ["env"]
                    }
                },

                "tier": {
                    "type": "string",
                    "enum": ["slow", "fast", "live"],
                    "description": "slow — hours/days. fast — minutes. live — real-time passthrough."
                },

                "refresh": {
                    "type": "string",
                    "pattern": "^(\\d+)(m|h|d)$",
                    "description": "Required for slow and fast tiers. Format: 30m, 6h, 1d."
                }

                },
                "allOf": [
                {
                    "if": {
                        "properties": { "tier": { "enum": ["slow", "fast"] } }
                    },
                    "then": {
                        "required": ["refresh"]
                    }
                },
                {
                    "if": {
                        "properties": { "tier": { "const": "live" } }
                    },
                    "then": {
                        "not": { "required": ["refresh"] }
                    }
                }
                ]
            }
        },

        "output": {
            "type": "object",
            "required": ["summary", "full", "max_field_tokens"],
            "additionalProperties": false,
            "properties": {
                "summary": {
                "type": "boolean",
                "description": "Whether to generate summary payloads."
                },
                "full": {
                "type": "boolean",
                "description": "Whether to generate full payloads."
                },
                "max_field_tokens": {
                "type": "integer",
                "minimum": 64,
                "maximum": 2048,
                "description": "Soft token cap per field. Fields exceeding this are truncated with a truncated: true flag."
                }
            }
        },

        "versioning": {
            "type": "object",
            "required": ["strategy"],
            "additionalProperties": false,
            "properties": {
                "strategy": {
                "type": "string",
                "enum": ["semver-timestamp"],
                "description": "Versioning strategy. CLI auto-detects bump level by diffing against last published package."
                }
            }
        }
    }
}